<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Silo Banque et Pointage (bank-pointage-core) : changelog Liquibase du silo (R-01, 24-backlog-reste-a-faire.md).
        Tables actuelles : bank_import_document, enable_banking_sync_state.

        Lot B (R-01) : changeSet de baseline ci-dessous, genere via `mvn liquibase:generateChangeLog`
        (cf. db/changelog/README.md, module server) sur une base neuve (reset propre, pas de
        reverse-engineering de l'existant : voir 23-registre-decisions-actives.md, DA-16). Tables
        legacy orphelines (anciens noms pre-renommage de silo, cf. LegacySchemaCleanup) exclues.
    -->

    <changeSet author="R-01-lot-b" id="r01-bank-pointage-core-1">
        <createTable tableName="bank_import_document">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="bank_import_document_pkey"/>
            </column>
            <column name="json_data" type="TEXT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet author="R-01-lot-b" id="r01-bank-pointage-core-2">
        <createTable tableName="enable_banking_sync_state">
            <column name="account_uid" type="VARCHAR(64)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="enable_banking_sync_state_pkey"/>
            </column>
            <column name="last_booking_date" type="VARCHAR(10)"/>
            <column name="last_sync_at" type="TIMESTAMP WITH TIME ZONE"/>
        </createTable>
    </changeSet>

    <!--
        Migration du stockage de l'import bancaire : bank_import_document (document JSON unique,
        R-01-lot-b ci-dessus) vers un schema relationnel, pour permettre le filtrage/tri/pagination
        cote SQL (ecran de categorisation) sans tout charger en memoire navigateur/serveur a chaque
        appel. Plan en etapes (voir areas/bank-pointage-relational-migration.md) :
          1. bank-reloc-core-1 a -9 ci-dessous : nouvelles tables, vides, non utilisees par le code
             applicatif pour le moment. Aucun impact sur bank_import_document, qui reste la source
             de verite tant que l'etape de bascule (JpaBankStore) n'est pas livree.
          2. Migration des donnees existantes (JSON -> lignes), via changeSet Java (CustomTaskChange),
             teste unitairement, pour garantir l'absence de perte de donnees.
          3. Bascule de JpaBankStore sur ces tables (meme contrat BankReader/BankWriter).
          4. Nouveau port de lecture paginee/filtree pour l'ecran de categorisation.
          5. Suppression de bank_import_document, differee (apres periode de confiance en prod).

        Choix de typage : les identifiants (BankTransactionModel.id, etc.) sont generes cote modele
        Java par UUID.randomUUID().toString().substring(0, 8) par defaut, mais peuvent aussi provenir
        d'un identifiant externe (import CSV, synchro Enable Banking) : VARCHAR(64) par prudence,
        plutot que de contraindre a 8 caracteres. Pas de contrainte de cle etrangere vers
        bank_category.id sur les colonnes category_id : le modele Java utilise une chaine vide ""
        (et non NULL) pour representer "non categorise" (BankImportModel.BankTransactionModel,
        constructeur compact), ce qui casserait une FK stricte ; la table bank_category ne contient
        jamais de categorie d'id vide. Cette conversion "" <-> NULL sera traitee au niveau du mapper
        lors de l'etape de bascule (etape 3), pas ici.
    -->
    <changeSet author="bank-reloc" id="bank-reloc-core-1">
        <createTable tableName="bank_column_mapping">
            <column name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="bank_column_mapping_pkey"/>
            </column>
            <column name="delimiter" type="VARCHAR(8)"/>
            <column name="date_format" type="VARCHAR(32)"/>
            <column name="has_header" type="BOOLEAN"/>
            <column name="date_col" type="INT"/>
            <column name="label_col" type="INT"/>
            <column name="type_col" type="INT"/>
            <column name="amount_col" type="INT"/>
            <!-- Listes de positions de colonnes CSV, rarement plus de 2-3 valeurs : stockees en
                 CSV d'entiers plutot que d'ajouter 3 tables de jointure pour une ligne de config
                 unique (contrairement a bank_transaction, cette table n'a pas vocation a etre
                 filtree/triee en SQL). -->
            <column name="extra_label_cols_csv" type="VARCHAR(255)"/>
            <column name="credit_cols_csv" type="VARCHAR(255)"/>
            <column name="debit_cols_csv" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>
    <changeSet author="bank-reloc" id="bank-reloc-core-2">
        <createTable tableName="bank_category">
            <column name="id" type="VARCHAR(64)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="bank_category_pkey"/>
            </column>
            <column name="label" type="VARCHAR(255)"/>
            <column name="kind" type="VARCHAR(32)"/>
            <column name="compressible" type="VARCHAR(8)"/>
        </createTable>
    </changeSet>
    <changeSet author="bank-reloc" id="bank-reloc-core-3">
        <createTable tableName="bank_rule">
            <column name="id" type="VARCHAR(64)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="bank_rule_pkey"/>
            </column>
            <column name="match_text" type="VARCHAR(255)"/>
            <column name="category_id" type="VARCHAR(64)"/>
        </createTable>
    </changeSet>
    <changeSet author="bank-reloc" id="bank-reloc-core-4">
        <createTable tableName="bank_transaction">
            <column name="id" type="VARCHAR(64)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="bank_transaction_pkey"/>
            </column>
            <column name="transaction_date" type="VARCHAR(32)"/>
            <column name="label" type="VARCHAR(512)"/>
            <column name="type" type="VARCHAR(32)"/>
            <column name="amount" type="DECIMAL(19,2)"/>
            <column name="category_id" type="VARCHAR(64)"/>
        </createTable>
        <createIndex indexName="bank_transaction_category_id_idx" tableName="bank_transaction">
            <column name="category_id"/>
        </createIndex>
        <createIndex indexName="bank_transaction_date_idx" tableName="bank_transaction">
            <column name="transaction_date"/>
        </createIndex>
    </changeSet>
    <changeSet author="bank-reloc" id="bank-reloc-core-5">
        <createTable tableName="bank_transaction_split">
            <column name="id" type="VARCHAR(64)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="bank_transaction_split_pkey"/>
            </column>
            <column name="transaction_id" type="VARCHAR(64)">
                <constraints nullable="false"
                             foreignKeyName="bank_transaction_split_transaction_fkey"
                             references="bank_transaction(id)"/>
            </column>
            <column name="category_id" type="VARCHAR(64)"/>
            <column name="amount" type="DECIMAL(19,2)"/>
            <column name="label" type="VARCHAR(512)"/>
        </createTable>
        <createIndex indexName="bank_transaction_split_transaction_id_idx" tableName="bank_transaction_split">
            <column name="transaction_id"/>
        </createIndex>
    </changeSet>
    <changeSet author="bank-reloc" id="bank-reloc-core-6">
        <createTable tableName="bank_pending_operation">
            <column name="id" type="VARCHAR(64)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="bank_pending_operation_pkey"/>
            </column>
            <column name="operation_date" type="VARCHAR(32)"/>
            <column name="expected_date" type="VARCHAR(32)"/>
            <column name="type" type="VARCHAR(16)"/>
            <column name="ref_number" type="VARCHAR(64)"/>
            <column name="label" type="VARCHAR(512)"/>
            <column name="amount" type="DECIMAL(19,2)"/>
            <column name="category_id" type="VARCHAR(64)"/>
            <column name="status" type="VARCHAR(16)"/>
            <column name="linked_tx_id" type="VARCHAR(64)"/>
            <column name="cleared_date" type="VARCHAR(32)"/>
            <column name="notes" type="VARCHAR(1024)"/>
            <column name="budget_line_id" type="VARCHAR(64)"/>
        </createTable>
    </changeSet>
    <changeSet author="bank-reloc" id="bank-reloc-core-7">
        <createTable tableName="bank_pending_operation_split">
            <column name="id" type="VARCHAR(64)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="bank_pending_operation_split_pkey"/>
            </column>
            <column name="pending_operation_id" type="VARCHAR(64)">
                <constraints nullable="false"
                             foreignKeyName="bank_pending_op_split_operation_fkey"
                             references="bank_pending_operation(id)"/>
            </column>
            <column name="category_id" type="VARCHAR(64)"/>
            <column name="amount" type="DECIMAL(19,2)"/>
            <column name="label" type="VARCHAR(512)"/>
        </createTable>
        <createIndex indexName="bank_pending_op_split_operation_id_idx" tableName="bank_pending_operation_split">
            <column name="pending_operation_id"/>
        </createIndex>
    </changeSet>
    <changeSet author="bank-reloc" id="bank-reloc-core-8">
        <createTable tableName="bank_matching">
            <column name="matching_month" type="VARCHAR(7)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="bank_matching_pkey"/>
            </column>
        </createTable>
    </changeSet>
    <changeSet author="bank-reloc" id="bank-reloc-core-9">
        <createTable tableName="bank_matching_link">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="bank_matching_link_pkey"/>
            </column>
            <column name="matching_month" type="VARCHAR(7)">
                <constraints nullable="false"/>
            </column>
            <column name="budget_line_id" type="VARCHAR(64)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="bank_matching_link"
                                 baseColumnNames="matching_month"
                                 constraintName="bank_matching_link_month_fkey"
                                 referencedTableName="bank_matching"
                                 referencedColumnNames="matching_month"/>
        <createIndex indexName="bank_matching_link_month_idx" tableName="bank_matching_link">
            <column name="matching_month"/>
        </createIndex>
    </changeSet>
    <changeSet author="bank-reloc" id="bank-reloc-core-10">
        <createTable tableName="bank_matching_link_tx">
            <column name="matching_link_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="bank_matching_link_tx_link_fkey"
                             references="bank_matching_link(id)"/>
            </column>
            <column name="tx_id" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="bank_matching_link_tx_link_id_idx" tableName="bank_matching_link_tx">
            <column name="matching_link_id"/>
        </createIndex>
    </changeSet>

    <!--
        Etape 2 du plan (voir commentaire plus haut) : copie, une seule fois, des donnees existantes de
        bank_import_document vers les tables ci-dessus. bank_import_document n'est ni modifiee ni
        supprimee par ce changeSet (lecture seule) : elle reste la copie de secours jusqu'a l'etape 5.
        Implementation en Java (CustomTaskChange) plutot qu'en SQL JSON brut : testable unitairement
        (garantie de non-perte de donnees exigee pour ce chantier), portable Postgres/H2 sans fonctions
        JSON specifiques a un moteur. La classe vit dans le composition root (module bootstrap, depot
        MyFamilyBudget) car c'est le seul module du projet qui depend a la fois de liquibase-core et de
        bank-pointage-core : voir server/internal/migration/BankImportRelationalMigration.java.
    -->
    <changeSet author="bank-reloc" id="bank-reloc-core-11">
        <customChange class="com.moe.myfamilybudget.server.internal.migration.BankImportRelationalMigration"/>
    </changeSet>

    <!--
        Correctif d'oubli de l'etape 1 : bank_matching_link_tx (bank-reloc-core-10) n'avait pas de cle
        primaire (simple table de jointure matching_link_id/tx_id). Necessaire pour la mapper en entite JPA
        a l'etape 3 (chaque @Entity a besoin d'un @Id). Additif et sans risque : la table est, au pire,
        deja peuplee par la migration de l'etape 2 (bank-reloc-core-11 ci-dessus), jamais avant ; ajouter
        une colonne auto-incrementee ne touche pas les colonnes existantes et n'a pas besoin d'etre
        reference par l'INSERT de la migration, qui ne la nomme pas.
    -->
    <changeSet author="bank-reloc" id="bank-reloc-core-12">
        <addColumn tableName="bank_matching_link_tx">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" primaryKeyName="bank_matching_link_tx_pkey"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
